cabal-version:   3.0
name:            persistent-d1
version:         0.1.0.0
synopsis:        A persistent backend for Cloudflare D1
description:
  Runs persistent's SQL API against Cloudflare D1 from Workers, reusing the
  SQLite dialect of persistent-sqlite. Statements commit one by one: D1 has no
  BEGIN/COMMIT, so persistent's transaction hooks do nothing.

license:         BSD-3-Clause
build-type:      Simple

library
  hs-source-dirs:   src
  exposed-modules:  Database.Persist.D1
  build-depends:
    , base               >=4.17 && <5
    , cloudflare-workers
    , conduit
    , persistent         ==2.17.*
    , persistent-sqlite  ==2.13.3.1
    , resource-pool
    , resourcet
    , text
    , transformers

  default-language: Haskell2010
  ghc-options:      -Wall
