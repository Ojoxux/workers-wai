cabal-version:   3.0
name:            test-vendor
version:         0.1.0.0
synopsis:        Checks the vendored crypto stack; driven by test/vendor.test.mjs
build-type:      Simple

executable test-vendor
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base
    , bytestring
    , crypton
    , memory
    , text
    , wai-handler-cloudflare
    , yesod-core

  default-language: Haskell2010
  ghc-options:
    -Wall -O1
    -no-hs-main
    -optl-mexec-model=reactor
