cabal-version:   3.0
name:            demo-wai
version:         0.1.0.0
synopsis:        Minimal WAI Application running on Cloudflare Workers
build-type:      Simple

executable demo-wai
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base
    , bytestring
    , case-insensitive
    , http-types
    , wai
    , wai-handler-cloudflare

  default-language: Haskell2010
  ghc-options:
    -Wall -O2
    -no-hs-main
    -optl-mexec-model=reactor
