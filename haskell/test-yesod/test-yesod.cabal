cabal-version:   3.0
name:            test-yesod
version:         0.1.0.0
synopsis:        Yesod app driven by test/session.test.mjs
build-type:      Simple

executable test-yesod
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base
    , bytestring
    , cloudflare-workers
    , persistent
    , persistent-d1
    , text
    , time
    , wai-handler-cloudflare
    , yesod-cloudflare
    , yesod-core
    , yesod-static

  default-language: Haskell2010
  ghc-options:
    -Wall -O1
    -no-hs-main
    -optl-mexec-model=reactor
