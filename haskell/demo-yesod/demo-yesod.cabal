cabal-version:   3.0
name:            demo-yesod
version:         0.1.0.0
synopsis:        Minimal Yesod application running on Cloudflare Workers
build-type:      Simple

executable demo-yesod
  main-is:          Main.hs
  hs-source-dirs:   app
  build-depends:
    , base
    , text
    , wai
    , wai-handler-cloudflare
    , yesod-core

  default-language: Haskell2010
  ghc-options:
    -Wall -O2
    -no-hs-main
    -optl-mexec-model=reactor
