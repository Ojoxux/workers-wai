# Bootstraps nix-direnv per-project, without touching global direnv config.
# See: https://github.com/nix-community/nix-direnv
if ! has nix_direnv_version || ! nix_direnv_version 3.2.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.2.0/direnvrc" "sha256-hW6NC1JHue3IjZN3uDM6l6I2PMaauqd2D7hXYJ1Zfr4="
fi

# Reload the dev shell whenever the flake's inputs or outputs change, not just
# when .envrc itself changes -- nix_direnv_watch_file below layers on top of
# nix-direnv's own tracking of files the flake evaluation actually reads.
watch_file flake.nix
watch_file flake.lock

use flake
